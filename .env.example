# Booking emails (src/lib/booking-request.ts) — sent through the Gmail API.
# Copy this file to .env.local for local development (.env.local is git-ignored),
# and add the same values as secrets on the hosting platform. Never commit real values.

# OAuth client from Google Cloud Console (APIs & Services → Credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Refresh token for master.tech.claude@gmail.com with the gmail.send scope
GMAIL_REFRESH_TOKEN=

# Optional overrides
# GMAIL_SENDER=master.tech.claude@gmail.com
# BOOKING_NOTIFY_EMAIL=xingtattoo.aecs@gmail.com
