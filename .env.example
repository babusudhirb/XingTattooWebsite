# Copy to .env.local for local builds (.env.local is git-ignored). On Cloudflare Pages / Netlify,
# add the same names under the project's environment variables. Never commit real values.

# Google Analytics: a GTM container (GTM-XXXX) or a GA4 measurement ID (G-XXXX). Leave empty for none.
VITE_GTM_ID=
VITE_GA_ID=

# Search Console / Bing ownership meta tags (not needed when the domain is verified by DNS)
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=

# IndexNow: any 8–128 letters/digits; the build publishes /<key>.txt, `npm run indexnow` pings Bing
INDEXNOW_KEY=

# Booking emails (src/lib/booking-request.ts, Gmail API). These only work on a host that runs the
# server functions; on static hosting the booking form hands the request to WhatsApp instead.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=
# BOOKING_NOTIFY_EMAIL=
