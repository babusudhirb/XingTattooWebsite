{
  "name": "xing-premium-tattoo-studio",
  "description": "Website of Xing Premium Tattoo Studio, Brookefield, Bangalore — TanStack Start, prerendered to static HTML",
  "homepage": "https://www.xingtattoo.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/altafs45/XING-TATTOO-STUDIO.git"
  },
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-seo-files.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:dev": "vite build --mode development",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seo:audit": "node scripts/qa/seo-audit.mjs http://localhost:4173",
    "check:nap": "node scripts/qa/nap-check.mjs http://localhost:4173",
    "seo:files": "node scripts/generate-seo-files.mjs",
    "check:links": "node scripts/qa/link-check.mjs",
    "check:mobile": "node scripts/qa/mobile-check.mjs",
    "lighthouse": "node scripts/qa/lighthouse.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "qa": "npm run seo:files && npm run build && node scripts/qa/seo-audit.mjs http://localhost:4173 && node scripts/qa/nap-check.mjs && node scripts/qa/link-check.mjs && node scripts/qa/mobile-check.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.0.4",
    "lighthouse": "^13.6.0",
    "nitro": "3.0.260603-beta",
    "node-html-parser": "^6.1.13",
    "playwright-core": "^1.64.1",
    "prettier": "^3.7.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
