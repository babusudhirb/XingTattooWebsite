# Xing Premium Tattoo Studio — Hostinger (LiteSpeed / Apache) rules.
# Uploaded with the site into public_html. scripts/postbuild.mjs fills in the generated redirects.

Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Every redirect targets https://www.xingtattoo.in directly, so any mix of http://,
  # bare domain, old URL, .html or trailing slash resolves in ONE 301.

  # Old or alternative URLs (from scripts/redirects.mjs)
  # BEGIN generated redirects
  RewriteRule ^index(\.html|/)?$ https://www.xingtattoo.in/ [R=301,L,NE]
  RewriteRule ^artist(\.html|/)?$ https://www.xingtattoo.in/tattoo-artist [R=301,L,NE]
  RewriteRule ^contact-us(\.html|/)?$ https://www.xingtattoo.in/contact [R=301,L,NE]
  RewriteRule ^service(\.html|/)?$ https://www.xingtattoo.in/services [R=301,L,NE]
  RewriteRule ^service/(.+?)(\.html|/)?$ https://www.xingtattoo.in/services/$1 [R=301,L,NE]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^404(\.html)?$ - [R=404,L]
  RewriteCond %{REQUEST_URI} [A-Z]
  RewriteRule ^about(\.html|/)?$ https://www.xingtattoo.in/about [NC,R=301,L,NE]
