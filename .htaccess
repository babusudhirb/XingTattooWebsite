  # END generated redirects

  # /about.html -> /about, /about/ -> /about (one clean URL per page)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ https://www.xingtattoo.in/%1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/+$ https://www.xingtattoo.in/$1 [R=301,L,NE]

  # One host, HTTPS only: http:// and the bare domain go to https://www.xingtattoo.in
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.xingtattoo\.in$ [NC]
  RewriteRule ^ https://www.xingtattoo.in%{REQUEST_URI} [L,R=301,NE]

  # Clean URLs: /about serves about.html, /services/realism serves services/realism.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Compression (LiteSpeed also applies Brotli automatically)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change: cache for a year
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Photos and icons: cache for a month
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages, sitemaps, robots.txt and feeds: always revalidate so edits show up immediately
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header set Content-Type "application/manifest+json"
  </FilesMatch>
  # HTTPS only from now on (no "preload" until every subdomain is confirmed to serve HTTPS)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddCharset utf-8 .txt .xml
</IfModule>
